    "def filter_sectors(row):\n",
    "    search_sector = \"construction\".lower()\n",
    "    target_row = row['sectorsOfWork']\n",
    "    if isinstance(target_row, list):\n",
    "        return search_sector in [sector.lower() for sector in target_row]\n",
    "    elif isinstance(target_row, str):\n",
    "        return target_row.lower() == search_sector\n",
    "    else:\n",
    "        return False\n",
    "\n",
    "filtered_df = df[df.apply(filter_sectors, axis=1)]\n",
    "filtered_df = filtered_df[filtered_df['location_of_potential_work'].isin(['UK', 'uk', 'GBR', 'United Kingdom'])]\n",
    "# vv = filtered_df[['location_of_potential_work', 'sectorsOfWork']]\n",
